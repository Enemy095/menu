# LOCAL DEVELOPMENT ONLY. Copy this file to .env; never reuse these values in production.
COMPOSE_PROJECT_NAME=emenu-local

# PostgreSQL 17 (default profile)
POSTGRES_DB=emenu
POSTGRES_USER=emenu
POSTGRES_PASSWORD=emenu_local_password
POSTGRES_PORT=5432

# Spring Boot local profile values (same names as application.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/emenu
DATABASE_USERNAME=emenu
DATABASE_PASSWORD=emenu_local_password
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_FORWARDING_ENABLED=false
TRUSTED_PROXY_CIDRS=
PUBLIC_BASE_URL=http://localhost:3000
ASSET_BASE_URL=http://localhost:9000/tenant-assets-local
APP_WORKER_ENABLED=false

# Optional tenant assets profile
MINIO_ROOT_USER=emenu-local
MINIO_ROOT_PASSWORD=emenu-local-password
MINIO_BUCKET=tenant-assets-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TENANT_ASSETS_ENDPOINT=http://localhost:9000
TENANT_ASSETS_PUBLIC_BASE_URL=http://localhost:9000/tenant-assets-local

# Optional observability profile
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090

# Production-only integrations stay empty in local development.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_HEADERS=
ASSETS_CDN_BASE_URL=
