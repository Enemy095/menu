# LOCAL DEVELOPMENT ONLY. Copy this file to .env; never reuse these values in production.
COMPOSE_PROJECT_NAME=emenu-local

# PostgreSQL 17 (default profile)
POSTGRES_DB=emenu
POSTGRES_USER=emenu
POSTGRES_PASSWORD=emenu_local_password
POSTGRES_PORT=5432

# Spring Boot local profile values (same names as application.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/emenu
DATABASE_USERNAME=emenu
DATABASE_PASSWORD=emenu_local_password
APP_SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_SECURITY_TRUSTED_PROXIES_ENABLED=false
APP_SECURITY_TRUSTED_PROXY_CIDRS=
APP_SECURITY_CORS_ALLOWED_ORIGINS=
ORDER_RATE_LIMIT_CLIENT_TOKENS_PER_MINUTE=5
ORDER_RATE_LIMIT_CLIENT_BURST=10
ORDER_RATE_LIMIT_APPLICATION_TOKENS_PER_MINUTE=120
ORDER_RATE_LIMIT_APPLICATION_BURST=240
ORDER_RATE_LIMIT_MAX_CLIENT_BUCKETS=50000
ORDER_RATE_LIMIT_BUCKET_EXPIRY=10m
PUBLIC_BASE_URL=http://localhost:3000
MENU_API_BASE_URL=http://localhost:8080
ASSET_BASE_URL=http://localhost:9000/menu-assets-local
APP_WORKER_ENABLED=false

# Optional single-client assets profile
MINIO_ROOT_USER=emenu-local
MINIO_ROOT_PASSWORD=emenu-local-password
MINIO_BUCKET=menu-assets-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ASSET_STORAGE_ENDPOINT=http://localhost:9000
ASSET_STORAGE_REGION=us-east-1
ASSET_STORAGE_BUCKET=menu-assets-local
ASSET_STORAGE_ACCESS_KEY=emenu-local
ASSET_STORAGE_SECRET_KEY=emenu-local-password
ASSET_STORAGE_PATH_STYLE_ACCESS=true

# Optional observability profile
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090

# Production-only integrations stay empty in local development.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_HEADERS=
