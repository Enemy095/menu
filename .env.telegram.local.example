# Copy this file to .env.telegram.local. The copied file is ignored by Git.
# Create a bot with @BotFather, paste the token below, send /start to the bot,
# then run: .\scripts\setup-telegram-local.ps1
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_DESTINATION_SECRET_REFERENCE=secret://application/telegram/orders
APP_WORKER_ENABLED=true
