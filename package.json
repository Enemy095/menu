{
  "name": "e-menu-rezvan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @e-menu/api-contract build && pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter @e-menu/api-contract typecheck && pnpm --filter web typecheck",
    "validate:architecture": "node scripts/check-forbidden-runtime-scope.mjs",
    "validate:acceptance": "node scripts/accept-stambul-full-stack.mjs",
    "validate:smoke": "node scripts/smoke-disposable-postgres.mjs",
    "validate:web": "pnpm --filter web check",
    "validate:full": "node scripts/validate.mjs"
  }
}
